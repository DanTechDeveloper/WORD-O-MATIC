FROM dunglas/frankenphp:1-php8.4-bookworm AS base

# Use production php.ini + required extensions (maatwebsite/excel needs gd+zip, laravel needs intl/bcmath)
RUN cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini" \
    && echo "max_execution_time=60" >> "$PHP_INI_DIR/php.ini" \
    && install-php-extensions intl zip gd pdo_mysql pdo_pgsql bcmath

WORKDIR /app

FROM node:20-bookworm AS node
FROM base AS dependencies

COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -sf /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && node -v && npm -v

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

COPY composer.json composer.lock ./

# Install PHP deps first (layer cache) — skip scripts until app copied
# (no --optimize-autoloader here: the classmap-authoritative dump below covers it)
RUN composer install \
    --no-dev \
    --no-interaction \
    --no-progress \
    --no-scripts \
    --prefer-dist

# Copy rest of app
COPY . .

# Build frontend — laravel-vite-plugin reads vite.config.js:7
RUN npm ci --ignore-scripts \
    && npm run build

# Writable dirs + Laravel caches that don't depend on runtime env
RUN mkdir -p \
        storage/framework/cache \
        storage/framework/sessions \
        storage/framework/views \
        bootstrap/cache \
    && composer dump-autoload --no-dev --classmap-authoritative \
    && php artisan event:cache || true \
    && php artisan view:cache || true \
    && php artisan route:cache || true
# ponytail: config:cache / optimize intentionally skipped — Vercel injects env at runtime (guide forbids).
# route:cache is safe (Laravel 13 serializes the closure routes, verified) and skips
# per-request route registration on every cold/warm container request.

FROM base AS runtime

COPY --from=dependencies --chown=www-data:www-data /app /app
COPY --chown=www-data:www-data Caddyfile /etc/frankenphp/Caddyfile

RUN setcap CAP_NET_BIND_SERVICE=+eip /usr/local/bin/frankenphp \
    && chown -R www-data:www-data /config/caddy /data/caddy

# ponytail: cookie + array — 0 DB queries for session/cache, YAGNI for 100 rows (was database cache for 60s). Deepgram token re-grants per cold, acceptable.
# Aiven MySQL 8.4 on DigitalOcean sfo requires SSL (REQUIRED) — ca.pem is copied via `COPY . .` above if present
ENV PORT=80 \
    APP_ENV=production \
    APP_DEBUG=false \
    LOG_CHANNEL=stderr \
    CACHE_STORE=array \
    SESSION_DRIVER=cookie \
    QUEUE_CONNECTION=sync \
    MYSQL_ATTR_SSL_CA=/app/ca.pem

USER www-data

# ponytail: warmup/health signal — exercises full Laravel boot via /up on a
# 30s cadence (keeps the container warm between classroom bursts). php binary
# is guaranteed present (no curl dependency). start-period covers cold boot;
# orchestrators that ignore HEALTHCHECK simply skip it (harmless).
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
    CMD php -r 'exit(@file_get_contents("http://127.0.0.1:".(getenv("PORT") ?: 80)."/up") ? 0 : 1);'

CMD ["frankenphp", "run", "--config", "/etc/frankenphp/Caddyfile"]
