{
    frankenphp {
        # ponytail: bound concurrent PHP threads so DB holders per container stay
        # small — concurrent requests x instances must fit Aiven max_connections
        # with headroom (raise only after checking max_connections + Vercel
        # concurrency; queuing degrades as latency, exhaustion as 500s).
        # No worker mode (needs Octane-style state handling) and no
        # PDO::ATTR_PERSISTENT (each worker already reuses its connection;
        # persistent flags only add stale-connection risk on scale-out).
        num_threads 8
    }
}

:{$PORT:80} {
    root * /app/public
    encode zstd gzip
    @assets path /build/*
    header @assets Cache-Control "public, max-age=31536000, immutable"
    @sfx path "/Sound Effects/*"
    header @sfx Cache-Control "public, max-age=31536000, immutable"

    php_server {
        try_files {path} index.php
    }
}
