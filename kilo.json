{
  "$schema": "https://app.kilo.ai/config.json",

  "instructions": [
    "AGENTS.md",
    "my-app/docs/**/*.md"
  ],

  "plugin": [
    "@maikokan/kilo-hindsight",
    "@kilocode/plugin",
    "@kilocode/shell-security",
    "@dietrichgebert/ponytail"
  ],

  "permission": {
    "edit": "ask",
    "webfetch": "allow",
    "read": "allow",

    "bash": {
      "*": "ask",

      "git status": "allow",
      "git diff": "allow",
      "git log": "allow",

      "composer *": "allow",
      "npm *": "allow",
      "bun *": "allow",

      "php artisan route:list": "allow",
      "php artisan test": "allow",

      "php artisan migrate*": "ask",
      "php artisan db:*": "ask",

      "git commit *": "ask",
      "git push *": "ask"
    }
  }
}
